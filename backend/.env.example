# ============================================================
# Sentinel AI — Environment Configuration
# ============================================================
# Copy this file to .env and fill in the values.
# Never commit .env to version control.
# ============================================================

# ── Application ──────────────────────────────────────────────
APP_ENV=development          # development | production
LOG_LEVEL=info               # debug | info | warning | error
LOG_FILE=                    # optional: path to log file

# ── Frontend URL (for CORS in production) ────────────────────
FRONTEND_URL=                # e.g. https://sentinel-ai.vercel.app

# ── AI Models ────────────────────────────────────────────────
# Set USE_MOCK_MODELS=false to activate real AI inference.
# Set USE_MOCK_MODELS=true for deployment (Render has no GPU).
USE_MOCK_MODELS=true

# Path to local model weights directory (local dev only)
# Place SegFormer weights in:        MODELS_DIR/SegFormer/
# Place Florence-2 weights in:       MODELS_DIR/Florence-2/
# Place SentenceTransformer in:      MODELS_DIR/SentenceTransformer/
MODELS_DIR=C:\Models

# Sentence Transformers model path or HuggingFace model name
# Set to a local path if weights are downloaded, or leave as model name to auto-download
SENTENCE_MODEL=C:\Models\SentenceTransformer

# ── Weather API ───────────────────────────────────────────────
# Free tier: https://openweathermap.org/api
# Leave blank to use simulation weather (always works without a key).
OPENWEATHER_API_KEY=
WEATHER_LIVE=false

# ── ChromaDB ─────────────────────────────────────────────────
# Persistent vector store for incident memory.
# Local dev: relative to backend/ directory
# Render deployment: use /tmp/chroma
CHROMA_PERSIST_DIR=../chroma

# ── Local LLM (Ollama) ───────────────────────────────────────
# Install Ollama: https://ollama.com
# Pull model:     ollama pull qwen2.5:3b-instruct
# System works without Ollama — falls back to deterministic templates.
# Ollama is not available on Render — fallback is used automatically.
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b-instruct

# ── Deployment (Render) ───────────────────────────────────────
# Render-specific overrides (set in Render dashboard, not here):
#   USE_MOCK_MODELS=true
#   CHROMA_PERSIST_DIR=/tmp/chroma
#   FRONTEND_URL=https://your-app.vercel.app
#   OPENWEATHER_API_KEY=your_key
# PORT is set automatically by Render — do not set manually.
