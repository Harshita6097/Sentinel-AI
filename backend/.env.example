# ============================================================
# Sentinel AI — Environment Configuration
# ============================================================
# Copy this file to .env and fill in the values.
# Never commit .env to version control.
# ============================================================

# ── Application ──────────────────────────────────────────────
APP_ENV=development          # development | production
LOG_LEVEL=info               # debug | info | warning | error
LOG_FILE=                    # optional: path to log file (auto-set in production)

# ── Frontend URL (for CORS in production) ────────────────────
FRONTEND_URL=                # e.g. https://sentinel-ai.vercel.app

# ── AI Models ────────────────────────────────────────────────
# Set USE_MOCK_MODELS=false to activate real AI inference.
# Models must be placed in MODELS_DIR before enabling.
USE_MOCK_MODELS=true

# Path to local model weights directory
# Place SegFormer weights in:  MODELS_DIR/SegFormer/
# Place Florence-2 weights in: MODELS_DIR/Florence-2/
MODELS_DIR=D:\GOALS\Models

# Sentence Transformers model name (downloaded automatically from HuggingFace)
SENTENCE_MODEL=all-MiniLM-L6-v2

# ── Weather API ───────────────────────────────────────────────
# Free tier: https://openweathermap.org/api
# Leave blank to use simulation weather (always works without a key).
OPENWEATHER_API_KEY=

# Set to true to use live weather even in development
WEATHER_LIVE=false

# ── ChromaDB ─────────────────────────────────────────────────
# Persistent vector store for incident memory.
# Relative to backend/ directory.
CHROMA_PERSIST_DIR=../chroma

# ── Local LLM (Ollama) ───────────────────────────────────────
# Install Ollama: https://ollama.com
# Pull model:     ollama pull qwen2.5:3b-instruct
# System works without Ollama — falls back to deterministic templates.
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b-instruct

# ── Deployment (Render) ───────────────────────────────────────
# These are set automatically by Render — do not set manually.
# PORT=10000
